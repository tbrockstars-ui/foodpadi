{
  "name": "foodpadi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "node scripts/fix-styled-jsx-react.js",
    "api:dev": "npm run start:dev --workspace=@foodpadi/api",
    "api:build": "npm run build --workspace=@foodpadi/api",
    "api:test": "npm run test --workspace=@foodpadi/api",
    "mobile:start": "npm run start --workspace=@foodpadi/mobile",
    "shared:build": "npm run build --workspace=@foodpadi/shared",
    "shared:test": "npm run test --workspace=@foodpadi/shared",
    "web:dev": "npm run dev --workspace=@foodpadi/web -- -p 3100",
    "web:build": "npm run shared:build && npm run build --workspace=@foodpadi/web"
  }
}
