# Server-only (no NEXT_PUBLIC_ prefix) — the browser never calls the NestJS
# API directly, only Next.js Route Handlers/Server Components do.
API_URL=http://localhost:4310

# Duplicated from the repo-root .env.example — Next.js resolves .env
# relative to process.cwd(), which npm workspace scripts set to this
# package's directory, not the monorepo root, so these must be set here too.
ADMIN_ACCESS_CODE=change-me
ADMIN_SESSION_SECRET=change-me-too
ADMIN_API_SECRET=change-me-admin-api

# "Continue with Google" on the login / register pages. The *Web* OAuth 2.0
# Client ID from Google Cloud Console (Credentials -> Create OAuth client ID
# -> Web application; add your site to "Authorized JavaScript origins").
# Client-side value, hence NEXT_PUBLIC_. Leave blank to hide the button.
# The API must accept this same id in GOOGLE_OAUTH_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The FoodPadi Android app's real, published Google Play Store listing URL
# (e.g. https://play.google.com/store/apps/details?id=uk.foodpadi.app) — set
# this only once the app is actually live on Play (see
# docs/PLAY_STORE_LISTING.md, "Not yet launch-ready"). Never guess/fabricate
# this — components/PlayStoreBadge.tsx shows a "Coming to Google Play soon"
# state whenever it's unset, rather than link anywhere. Client-side value,
# hence NEXT_PUBLIC_.
NEXT_PUBLIC_PLAY_STORE_URL=

# A real, directly-installable APK (e.g. an EAS preview build URL) to offer
# before the app is actually published to Play — separate from
# NEXT_PUBLIC_PLAY_STORE_URL above so "download it now" is never presented as
# "live on Google Play". PlayStoreBadge.tsx only falls back to this once
# NEXT_PUBLIC_PLAY_STORE_URL is unset, and renders it as a plain "direct
# download" badge, not Google's Play Store artwork. Client-side value, hence
# NEXT_PUBLIC_.
NEXT_PUBLIC_ANDROID_APK_URL=

# The FoodPadi iOS app's real App Store listing URL, once one exists —
# FoodPadi has no iOS build yet (Android is the launch platform; iOS visitors
# get the waitlist at /ios-waitlist). Until then, components/AppStoreBadge.tsx
# falls back to a demo link (Apple's own App Store homepage) rather than a
# fake FoodPadi listing — user instruction 2026-09-16. Set this to the real
# listing and remove the demo fallback in AppStoreBadge.tsx once published.
NEXT_PUBLIC_APP_STORE_URL=
