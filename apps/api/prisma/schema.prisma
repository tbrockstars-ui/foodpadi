// FoodPadi API — Phase 1 (Foundation) schema.
// Covers: identity, household, preferences, goals, avoided ingredients,
// disclaimer acknowledgement, and AI memory scaffolding.
// Later phases (recipes, planning, pantry, shopping, subscriptions) extend
// this file — see docs/DATABASE_SCHEMA.md for the full target model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String?
  authProvider             String    @default("password") // "password" | "apple" | "google"
  // Personal referral code ("Feed a Friend", docs/REFERRAL_PLAN.md). Minted
  // lazily the first time the user asks for their invite link — most accounts
  // never share, so there's no point generating one at registration.
  referralCode             String?   @unique @map("referral_code")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  profile                  UserProfile?
  foodGoals                FoodGoal[]
  foodPreferences          FoodPreference[]
  avoidedIngredients       AvoidedIngredient[]
  householdMemberships     HouseholdMember[]
  createdHouseholds        Household[]        @relation("HouseholdCreator")
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  aiMemory                 AiMemory[]
  recipes                  Recipe[]
  foodEvents               FoodEvent[]
  mealPlans                MealPlan[]
  shoppingLists            ShoppingList[]
  pantryItems              PantryItem[]
  referralsMade            Referral[]        @relation("Referrer")
  referralReceived         Referral?         @relation("Referred")
  referralMilestones       ReferralMilestone[]

  @@map("users")
}

model UserProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName              String?   @map("display_name")
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at")
  disclaimerAcknowledgedAt DateTime? @map("disclaimer_acknowledged_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Household {
  id        String            @id @default(uuid())
  name      String
  createdBy String            @map("created_by")
  creator   User              @relation("HouseholdCreator", fields: [createdBy], references: [id])
  members   HouseholdMember[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("households")
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  joinedAt    DateTime  @default(now()) @map("joined_at")

  @@unique([householdId, userId])
  @@map("household_members")
}

// Non-medical goal set only — spec §10 / Decision 13. Never extend this with
// body-shape or weight-loss framed values.
//
// A user's current goals are the isActive=true rows (0-3, exactly one
// isPrimary). setGoals() deactivates the old active set and inserts a fresh
// batch rather than mutating in place, so full history is preserved.
model FoodGoal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType  String   @map("goal_type")
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  note      String?  @map("note") // only set when goalType === 'personal'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("food_goals")
}

model FoodPreference {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine           String?
  likedMeal         String?   @map("liked_meal")
  dislikedIngredient String?  @map("disliked_ingredient")
  textureDislike    String?   @map("texture_dislike")
  cookingStyle      String?   @map("cooking_style")
  source            String    @default("explicit") // "explicit" | "inferred"
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("food_preferences")
}

// Free-text `note` is treated as potentially special-category data
// (docs/PRIVACY_DATA_MODEL.md) — encrypted at rest in a later hardening
// pass, excluded from analytics exports, never solicited for a medical reason.
model AvoidedIngredient {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientName String    @map("ingredient_name")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  @@map("avoided_ingredients")
}

// Analytics events, derived from real domain actions rather than a parallel
// tracking SDK (docs/ANALYTICS_PLAN.md). Either userId or guestSessionId is
// set, never neither — guest activity (Eat Now/Cook Today) is tracked
// separately from account activity until/unless the guest converts.
model FoodEvent {
  id             String    @id @default(uuid())
  userId         String?   @map("user_id")
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?   @map("guest_session_id")
  eventType      String    @map("event_type")
  metadata       Json?
  occurredAt     DateTime  @default(now()) @map("occurred_at")

  @@index([userId])
  @@index([guestSessionId])
  @@index([eventType])
  @@map("food_events")
}

// "Feed a Friend" referral attribution (docs/REFERRAL_PLAN.md, Phase 1a). One
// row per referred person — `referredUserId` is unique, so "reward a referral
// once, ever" is a database constraint rather than application logic. Derived
// from real registration + activity events, in the same spirit as FoodEvent
// (no parallel tracking pixel).
//
// status lifecycle:
//   pending    — friend registered via a referral link, no meaningful action yet
//   qualified  — friend has since performed a qualifying action (see
//                referrals/qualifying-events.ts)
//   rewarded   — reserved: a future paid perk (Plus days / ad-free) was granted
//                for this referral. Phase 1b rewards are recognition-only
//                (ReferralMilestone) and do NOT set this — see docs/REFERRAL_PLAN.md.
model Referral {
  id             String    @id @default(uuid())
  referrerUserId String    @map("referrer_user_id")
  referrer       User      @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId String    @unique @map("referred_user_id")
  referred       User      @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  codeUsed       String    @map("code_used")
  status         String    @default("pending") // "pending" | "qualified" | "rewarded"
  // SHA-256 of the referred user's signup IP — kept only for manual abuse
  // review (docs/PRIVACY_DATA_MODEL.md: never store a raw IP). Not used for
  // any automated blocking in Phase 1a.
  signupIpHash   String?   @map("signup_ip_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  qualifiedAt    DateTime? @map("qualified_at")
  rewardedAt     DateTime? @map("rewarded_at")

  @@index([referrerUserId])
  @@index([status])
  @@map("referrals")
}

// "Feed a Friend" Phase 1b — the reward for a successful referral is
// recognition, not a paid perk (docs/REFERRAL_PLAN.md §3 / strategy §11: keep
// the marginal cost at zero until unit economics are known). One row per
// (user, kind, tier) badge earned; `seenAt` gates a once-only celebration in
// the UI. A real paid reward later becomes a new `kind` here (or its own
// table) with a grant — nothing about this shape needs to change.
//
//   kind = "referrer_tier"      tier = qualified-referral count crossed (1/3/5/10)
//   kind = "joined_via_friend"  tier = 0, minted for the *referred* user on signup
model ReferralMilestone {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  tier      Int       @default(0)
  label     String
  reachedAt DateTime  @default(now()) @map("reached_at")
  seenAt    DateTime? @map("seen_at")

  @@unique([userId, kind, tier])
  @@index([userId])
  @@map("referral_milestones")
}

// AI-generated (or, later, curated) recipes. No master ingredient catalog
// (spec §13 Principle 6 — "do not build another generic recipe database");
// ingredients are free-text per recipe, validated for internal consistency
// (Layer 3) rather than matched against a reference table. Only persisted
// when a signed-in user saves a result — guest-mode results are ephemeral.
model Recipe {
  id              String    @id @default(uuid())
  title           String
  cookTimeMinutes Int       @map("cook_time_minutes")
  servings        Int
  cuisine         String?
  steps           Json
  source          String    @default("ai_generated") // "ai_generated" | "curated"
  createdByUserId String?   @map("created_by_user_id")
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  ingredients     RecipeIngredient[]
  mealPlanItems   MealPlanItem[]

  @@map("recipes")
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity String?
  unit     String?

  @@map("recipe_ingredients")
}

// Plan Ahead is account-first, not guest-accessible (docs/
// FOODPADI_ONBOARDING_SPEC.md) — its value IS the persisted plan, so every
// meal gets a real Recipe row the moment it's generated, not only on save
// (unlike Cook Today's ephemeral-until-saved guest results).
model MealPlan {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String    // "today" | "3day" | "week" | "custom"
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  budgetPence Int?      @map("budget_pence")
  status      String    @default("draft") // "draft" | "accepted" | "completed" | "abandoned"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  items         MealPlanItem[]
  shoppingLists ShoppingList[]

  @@map("meal_plans")
}

model MealPlanItem {
  id          String   @id @default(uuid())
  mealPlanId  String   @map("meal_plan_id")
  mealPlan    MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId    String?  @map("recipe_id")
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  mealSlot    String   @default("dinner") @map("meal_slot") // "breakfast" | "lunch" | "dinner" | "snack"
  plannedDate DateTime @map("planned_date")
  servings    Int      @default(2)
  status      String   @default("planned") // "planned" | "cooked" | "skipped" | "swapped" | "rescued"
  // "cook" (default — use the attached recipe) or "eat_out" (Get It instead
  // of Cook It for this slot, mirroring the decision engine's two terminal
  // actions at plan level). recipe stays attached either way — switching to
  // eat_out doesn't discard it, in case the user switches back.
  mealChoice  String   @default("cook") @map("meal_choice")
  // "HH:mm" 24h, optional — when set, the client (currently mobile only)
  // schedules a local reminder 30 minutes before this time so the user
  // doesn't miss the window to start cooking or place an order.
  plannedTime String?  @map("planned_time")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("meal_plan_items")
}

// Consolidation (duplicate ingredients across a plan's meals collapsed into
// one line) happens in the service layer at generation time, not here —
// see docs/PLAN_AHEAD notes in PlanAheadService.buildShoppingListItems.
model ShoppingList {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanId String?   @map("meal_plan_id")
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  status     String    @default("open") // "open" | "completed"
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  items ShoppingListItem[]

  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  shoppingListId String       @map("shopping_list_id")
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredientName String       @map("ingredient_name")
  quantity       String?
  unit           String?
  checked        Boolean      @default(false)
  addedManually  Boolean      @default(false) @map("added_manually")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("shopping_list_items")
}

// Long-term AI memory only — curated, user-visible facts (spec §36).
// Short-term conversation history is intentionally not modelled yet;
// it lands with the Companion phase (Phase 5) alongside retention/TTL policy.
model AiMemory {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      String
  source     String    @default("explicit") // "explicit" | "inferred"
  confidence Float?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("ai_memory")
}

// Pre-launch web landing page signup — not tied to a User account (the app
// isn't released yet, so there's nothing to log into). Just an email capture.
model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_signups")
}

// Scan (Phase 6): a photo of food is analysed (Layer 5, vision) into
// candidate items, but nothing here is written until the user explicitly
// confirms the reviewed list — this table only ever holds confirmed rows,
// never raw scan output. `source` distinguishes how an item was added.
model PantryItem {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  quantity   String?
  unit       String?
  source     String    @default("manual") // "manual" | "scan_photo"
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([userId])
  @@map("pantry_items")
}

// Staff authentication for the admin console (apps/web/app/admin) — deliberately
// its own table, never sharing rows/sessions with the customer User model
// (docs/TECHNICAL_ARCHITECTURE.md §2.7: admin auth must stay entirely separate
// from end-user auth). Replaces the single shared ADMIN_ACCESS_CODE placeholder
// so admin actions are attributable to an actual staff member, not just "someone
// with the code". No self-service signup — accounts are created by a script
// (apps/api/scripts/create-admin-staff-user.ts), run by whoever administers
// this deployment.
model AdminStaffUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admin_staff_users")
}

// Eat Now's catalog (docs/IMPLEMENTATION_PLAN.md Phase 4) — was a hardcoded
// array in eat-now-catalog.ts requiring a code deploy to change a single
// dish; moved here so admin/food-ideas can manage it directly. `slug` keeps
// the original human-readable ids (e.g. "shawarma-wrap") stable across the
// migration — EatNowService's matching logic is unchanged, just reads these
// rows (isActive: true) instead of the static array. `isActive` is a soft
// toggle (same "suspend, don't destroy" precedent as User.deletedAt) so a
// dish can be hidden without losing it; the admin UI also allows a real
// hard delete for a genuine mistake entry.
model FoodIdea {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  cuisine     String
  budgetTier  String   @map("budget_tier") // 'low' | 'medium' | 'high'
  tags        String[]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("food_ideas")
}

// Cache for the representative food photos shown on recommendation cards
// (the visual "what should I eat" experience). One row per normalised food
// name, so an image provider (Pexels, with Unsplash as fallback) is called
// at most once per distinct dish, ever — repeat recommendations reuse the
// row. Photos are hotlinked from the provider CDN as their API terms
// require; nothing is downloaded or re-hosted here. A lookup that found
// nothing is cached too (`status = "none"`) with a short TTL, so a miss
// doesn't re-hit the provider on every page load. See FoodImageService.
model FoodImageCache {
  id               String   @id @default(uuid())
  key              String   @unique // normalised food name (lowercased, punctuation-stripped)
  foodName         String   @map("food_name")
  searchQuery      String   @map("search_query")
  status           String   @default("ok") // "ok" | "none"
  provider         String? // "pexels" | "unsplash"
  imageUrl         String?  @map("image_url")
  thumbnailUrl     String?  @map("thumbnail_url")
  photographerName String?  @map("photographer_name")
  photographerUrl  String?  @map("photographer_url")
  sourceUrl        String?  @map("source_url")
  // Unsplash requires a GET to this endpoint when a photo is actually
  // displayed; null for Pexels (no such requirement).
  downloadLocation String?  @map("download_location")
  isRepresentative Boolean  @default(true) @map("is_representative")
  retrievedAt      DateTime @default(now()) @map("retrieved_at")

  @@map("food_image_cache")
}
