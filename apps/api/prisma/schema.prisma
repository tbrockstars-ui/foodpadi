// FoodPadi API — Phase 1 (Foundation) schema.
// Covers: identity, household, preferences, goals, avoided ingredients,
// disclaimer acknowledgement, and AI memory scaffolding.
// Later phases (recipes, planning, pantry, shopping, subscriptions) extend
// this file — see docs/DATABASE_SCHEMA.md for the full target model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  authProvider String    @default("password") // "password" | "apple" | "google"
  // Personal referral code ("Feed a Friend", docs/REFERRAL_PLAN.md). Minted
  // lazily the first time the user asks for their invite link — most accounts
  // never share, so there's no point generating one at registration.
  referralCode String?   @unique @map("referral_code")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile                 UserProfile?
  foodGoals               FoodGoal[]
  foodPreferences         FoodPreference[]
  avoidedIngredients      AvoidedIngredient[]
  householdMemberships    HouseholdMember[]
  createdHouseholds       Household[]              @relation("HouseholdCreator")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  aiMemory                AiMemory[]
  recipes                 Recipe[]
  foodEvents              FoodEvent[]
  mealPlans               MealPlan[]
  shoppingLists           ShoppingList[]
  pantryItems             PantryItem[]
  referralsMade           Referral[]               @relation("Referrer")
  referralReceived        Referral?                @relation("Referred")
  referralMilestones      ReferralMilestone[]
  foodPatterns            FoodPattern[]
  companionSuggestions    CompanionSuggestion[]
  companionPreference     CompanionPreference?
  foodFeedback            FoodFeedback[]
  subscription            Subscription?
  cookingJourneys         CookingJourney[]
  dailyReminderPreference DailyReminderPreference?
  // FoodPadi Food Dealer Network (dealer brief §51/§52): a dealer signs in with
  // an ordinary customer account — no parallel auth. The Dealer row's
  // ownerUserId is the ownership key every portal endpoint authorizes on.
  // Array (not a to-one) so a future operator can hold more than one dealer;
  // the MVP portal UI assumes exactly one.
  dealers                 Dealer[]                 @relation("DealerOwner")
  dealerReports           DealerReport[]           @relation("DealerReporter")
  dealerRatings           DealerRating[]           @relation("DealerRater")

  @@map("users")
}

model UserProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName              String?   @map("display_name")
  // ISO 3166-1 alpha-2 country of residence, collected at registration. Drives
  // the FoodPadi Premium currency + local price (BillingService.getPricing) and
  // which payment provider a checkout routes to (Stripe vs Flutterwave for NG).
  // Nullable: pre-existing accounts and Google/mobile signups may not have it
  // until the user sets it (Profile / the paywall's country picker).
  countryCode              String?   @map("country_code")
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at")
  disclaimerAcknowledgedAt DateTime? @map("disclaimer_acknowledged_at")
  // In-app "7-day trial" of FoodPadi AI (Guest/Trial/Paid model — docs/
  // SUBSCRIPTION_MODEL.md). Set once at signup, never cleared: after
  // trialEndsAt passes, a user with no active Subscription resolves to the
  // GUEST entitlement (account + data kept, AI off). Distinct from Stripe's
  // own card-gated trial (Subscription.trialEndsAt / BillingConfig.trialDays).
  trialStartedAt           DateTime? @map("trial_started_at")
  trialEndsAt              DateTime? @map("trial_ends_at")
  // Server-side counter of AI calls made during the trial, checked against
  // BillingConfig.trialAiLimit by AiAccessService. Never trusted from a client.
  trialAiUsedCount         Int       @default(0) @map("trial_ai_used_count")
  // Avatar picker (user instruction 2026-09-11) — a deterministic, no-asset
  // icon: an emoji tied to the user's birth month, in one of 3 colour shades.
  // birthMonth is 1-12 (or null, never set) and only drives which month's
  // icon the picker defaults to; avatarId ("<month>-<shade>", validated
  // against packages/shared/src/avatars.ts) is the actual chosen icon and can
  // be from any month — someone can like a different month's look.
  birthMonth               Int?      @map("birth_month")
  avatarId                 String?   @map("avatar_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Household {
  id        String            @id @default(uuid())
  name      String
  createdBy String            @map("created_by")
  creator   User              @relation("HouseholdCreator", fields: [createdBy], references: [id])
  members   HouseholdMember[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("households")
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  joinedAt    DateTime  @default(now()) @map("joined_at")

  @@unique([householdId, userId])
  @@map("household_members")
}

// Non-medical goal set only — spec §10 / Decision 13. Never extend this with
// body-shape or weight-loss framed values.
//
// A user's current goals are the isActive=true rows (0-3, exactly one
// isPrimary). setGoals() deactivates the old active set and inserts a fresh
// batch rather than mutating in place, so full history is preserved.
model FoodGoal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType  String   @map("goal_type")
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  note      String?  @map("note") // only set when goalType === 'personal'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("food_goals")
}

model FoodPreference {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine            String?
  likedMeal          String?   @map("liked_meal")
  dislikedIngredient String?   @map("disliked_ingredient")
  textureDislike     String?   @map("texture_dislike")
  cookingStyle       String?   @map("cooking_style")
  source             String    @default("explicit") // "explicit" | "inferred"
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@map("food_preferences")
}

// Free-text `note` is treated as potentially special-category data
// (docs/PRIVACY_DATA_MODEL.md) — encrypted at rest in a later hardening
// pass, excluded from analytics exports, never solicited for a medical reason.
model AvoidedIngredient {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientName String    @map("ingredient_name")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  @@map("avoided_ingredients")
}

// Analytics events, derived from real domain actions rather than a parallel
// tracking SDK (docs/ANALYTICS_PLAN.md). Either userId or guestSessionId is
// set, never neither — guest activity (Eat Now/Cook Today) is tracked
// separately from account activity until/unless the guest converts.
model FoodEvent {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?  @map("guest_session_id")
  eventType      String   @map("event_type")
  metadata       Json?
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@index([userId])
  @@index([guestSessionId])
  @@index([eventType])
  @@map("food_events")
}

// "Feed a Friend" referral attribution (docs/REFERRAL_PLAN.md, Phase 1a). One
// row per referred person — `referredUserId` is unique, so "reward a referral
// once, ever" is a database constraint rather than application logic. Derived
// from real registration + activity events, in the same spirit as FoodEvent
// (no parallel tracking pixel).
//
// status lifecycle:
//   pending    — friend registered via a referral link, no meaningful action yet
//   qualified  — friend has since performed a qualifying action (see
//                referrals/qualifying-events.ts)
//   rewarded   — reserved: a future paid perk (Plus days / ad-free) was granted
//                for this referral. Phase 1b rewards are recognition-only
//                (ReferralMilestone) and do NOT set this — see docs/REFERRAL_PLAN.md.
model Referral {
  id             String    @id @default(uuid())
  referrerUserId String    @map("referrer_user_id")
  referrer       User      @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId String    @unique @map("referred_user_id")
  referred       User      @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  codeUsed       String    @map("code_used")
  status         String    @default("pending") // "pending" | "qualified" | "rewarded"
  // SHA-256 of the referred user's signup IP — kept only for manual abuse
  // review (docs/PRIVACY_DATA_MODEL.md: never store a raw IP). Not used for
  // any automated blocking in Phase 1a.
  signupIpHash   String?   @map("signup_ip_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  qualifiedAt    DateTime? @map("qualified_at")
  rewardedAt     DateTime? @map("rewarded_at")

  @@index([referrerUserId])
  @@index([status])
  @@map("referrals")
}

// "Feed a Friend" Phase 1b — the reward for a successful referral is
// recognition, not a paid perk (docs/REFERRAL_PLAN.md §3 / strategy §11: keep
// the marginal cost at zero until unit economics are known). One row per
// (user, kind, tier) badge earned; `seenAt` gates a once-only celebration in
// the UI. A real paid reward later becomes a new `kind` here (or its own
// table) with a grant — nothing about this shape needs to change.
//
//   kind = "referrer_tier"      tier = qualified-referral count crossed (1/3/5/10)
//   kind = "joined_via_friend"  tier = 0, minted for the *referred* user on signup
model ReferralMilestone {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  tier      Int       @default(0)
  label     String
  reachedAt DateTime  @default(now()) @map("reached_at")
  seenAt    DateTime? @map("seen_at")

  @@unique([userId, kind, tier])
  @@index([userId])
  @@map("referral_milestones")
}

// AI-generated (or, later, curated) recipes. No master ingredient catalog
// (spec §13 Principle 6 — "do not build another generic recipe database");
// ingredients are free-text per recipe, validated for internal consistency
// (Layer 3) rather than matched against a reference table. Only persisted
// when a signed-in user saves a result — guest-mode results are ephemeral.
model Recipe {
  id              String    @id @default(uuid())
  title           String
  cookTimeMinutes Int       @map("cook_time_minutes")
  servings        Int
  cuisine         String?
  steps           Json
  source          String    @default("ai_generated") // "ai_generated" | "curated"
  createdByUserId String?   @map("created_by_user_id")
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  // Set (and overwritten on every re-cook) when the owner finishes a guided
  // Cook Today session for this recipe — apps/web CookingSession /
  // apps/mobile CookingSessionScreen's "Finish Cooking" step, independent of
  // whether they go on to rate it. Home's "Recently cooked" engine
  // (HomeService.getRecentlyCooked) is the only reader.
  lastCookedAt    DateTime? @map("last_cooked_at")
  // Explicit "loved" flag — the heart on a recipe card (LikeHeart.tsx).
  // The Favorites engine (CookTodayService.listFavorites) shows a recipe
  // here OR because it has a 5-star FoodFeedback rating — this flag alone
  // doesn't decide favourite status, it's one of two signals.
  isFavorite      Boolean   @default(false) @map("is_favorite")

  ingredients     RecipeIngredient[]
  mealPlanItems   MealPlanItem[]
  cookingJourneys CookingJourney[]

  @@index([createdByUserId, lastCookedAt])
  @@map("recipes")
}

model RecipeIngredient {
  id       String  @id @default(uuid())
  recipeId String  @map("recipe_id")
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity String?
  unit     String?

  @@map("recipe_ingredients")
}

// Plan Ahead is account-first, not guest-accessible (docs/
// FOODPADI_ONBOARDING_SPEC.md) — its value IS the persisted plan, so every
// meal gets a real Recipe row the moment it's generated, not only on save
// (unlike Cook Today's ephemeral-until-saved guest results).
model MealPlan {
  id                           String    @id @default(uuid())
  userId                       String    @map("user_id")
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope                        String // "today" | "3day" | "week" | "custom"
  startDate                    DateTime  @map("start_date")
  endDate                      DateTime  @map("end_date")
  budgetPence                  Int?      @map("budget_pence")
  status                       String    @default("draft") // "draft" | "accepted" | "completed" | "abandoned"
  // "HH:mm" 24h, optional plan-wide default eating time — an item with no
  // plannedTime of its own inherits this (see packages/shared/src/
  // planTiming.ts's effectivePlannedTime). Null means no default has been
  // configured, same as before this field existed: every item is
  // independently null unless explicitly set.
  defaultMealTime              String?   @map("default_meal_time")
  // Minutes before the effective planned time that a reminder fires — an
  // item with no reminderOffsetMinutes of its own inherits this. Defaults to
  // 30 (the previous hardcoded value everywhere) so every existing plan
  // keeps today's exact behaviour with zero migration risk; 0 means "no
  // reminder".
  defaultReminderOffsetMinutes Int       @default(30) @map("default_reminder_offset_minutes")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  deletedAt                    DateTime? @map("deleted_at")

  items         MealPlanItem[]
  shoppingLists ShoppingList[]

  @@map("meal_plans")
}

model MealPlanItem {
  id                    String   @id @default(uuid())
  mealPlanId            String   @map("meal_plan_id")
  mealPlan              MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId              String?  @map("recipe_id")
  recipe                Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  mealSlot              String   @default("dinner") @map("meal_slot") // "breakfast" | "lunch" | "dinner" | "snack"
  plannedDate           DateTime @map("planned_date")
  servings              Int      @default(2)
  status                String   @default("planned") // "planned" | "cooked" | "skipped" | "swapped" | "rescued"
  // "cook" (default — use the attached recipe) or "eat_out" (Get It instead
  // of Cook It for this slot, mirroring the decision engine's two terminal
  // actions at plan level). recipe stays attached either way — switching to
  // eat_out doesn't discard it, in case the user switches back.
  mealChoice            String   @default("cook") @map("meal_choice")
  // "HH:mm" 24h, optional — when set, the client schedules a local reminder
  // before this time so the user doesn't miss the window to start cooking or
  // place an order. Null means "inherit MealPlan.defaultMealTime" — see
  // packages/shared/src/planTiming.ts's effectivePlannedTime.
  plannedTime           String?  @map("planned_time")
  // Per-day override for MealPlan.defaultReminderOffsetMinutes — null
  // inherits the plan default, an explicit value (including 0 for "no
  // reminder") overrides it just for this day.
  reminderOffsetMinutes Int?     @map("reminder_offset_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  cookingJourneys CookingJourney[]

  @@map("meal_plan_items")
}

// Consolidation (duplicate ingredients across a plan's meals collapsed into
// one line) happens in the service layer at generation time, not here —
// see docs/PLAN_AHEAD notes in PlanAheadService.buildShoppingListItems.
model ShoppingList {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanId String?   @map("meal_plan_id")
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  status     String    @default("open") // "open" | "completed"
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  items          ShoppingListItem[]
  // Set only for a list created from Cook Today's fridge-check inside an
  // active Cooking Journey (back-reference; the FK column lives on
  // CookingJourney.shoppingListId, which is @unique — at most one list here).
  cookingJourney CookingJourney?

  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  shoppingListId String       @map("shopping_list_id")
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredientName String       @map("ingredient_name")
  quantity       String?
  unit           String?
  checked        Boolean      @default(false)
  addedManually  Boolean      @default(false) @map("added_manually")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("shopping_list_items")
}

// Long-term AI memory only — curated, user-visible facts (spec §36).
// Short-term conversation history is intentionally not modelled yet;
// it lands with the Companion phase (Phase 5) alongside retention/TTL policy.
model AiMemory {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      String
  source     String    @default("explicit") // "explicit" | "inferred"
  confidence Float?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("ai_memory")
}

// Pre-launch web landing page signup — not tied to a User account (the app
// isn't released yet, so there's nothing to log into). Just an email capture.
model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Separate from waitlist membership itself — joining the waitlist is NOT
  // marketing consent. Only set when the (unticked-by-default) checkbox was
  // actually checked; version/timestamp record exactly what wording they
  // agreed to and when (see packages/shared/src/consent.ts).
  marketingConsent        Boolean   @default(false) @map("marketing_consent")
  marketingConsentVersion String?   @map("marketing_consent_version")
  marketingConsentAt      DateTime? @map("marketing_consent_at")

  // What this signup is actually for — the same table backs both the
  // generic "notify me about new features" form and the iOS-specific
  // waitlist, rather than duplicating waitlist infrastructure. Only ever
  // moves general -> ios_waitlist (more specific), never back.
  purpose  String  @default("general") @map("purpose")
  // First-touch attribution only (?source=/?campaign=) — set on first
  // signup, never overwritten by a later re-submission with different or
  // absent params.
  source   String? @map("source")
  campaign String? @map("campaign")

  @@map("waitlist_signups")
}

// Scan (Phase 6): a photo of food is analysed (Layer 5, vision) into
// candidate items, but nothing here is written until the user explicitly
// confirms the reviewed list — this table only ever holds confirmed rows,
// never raw scan output. `source` distinguishes how an item was added.
model PantryItem {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  quantity  String?
  unit      String?
  source    String    @default("manual") // "manual" | "scan_photo"
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@map("pantry_items")
}

// Staff authentication for the admin console (apps/web/app/admin) — deliberately
// its own table, never sharing rows/sessions with the customer User model
// (docs/TECHNICAL_ARCHITECTURE.md §2.7: admin auth must stay entirely separate
// from end-user auth). Replaces the single shared ADMIN_ACCESS_CODE placeholder
// so admin actions are attributable to an actual staff member, not just "someone
// with the code". No self-service signup — accounts are created by a script
// (apps/api/scripts/create-admin-staff-user.ts), run by whoever administers
// this deployment.
model AdminStaffUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admin_staff_users")
}

// Eat Now's catalog (docs/IMPLEMENTATION_PLAN.md Phase 4) — was a hardcoded
// array in eat-now-catalog.ts requiring a code deploy to change a single
// dish; moved here so admin/food-ideas can manage it directly. `slug` keeps
// the original human-readable ids (e.g. "shawarma-wrap") stable across the
// migration — EatNowService's matching logic is unchanged, just reads these
// rows (isActive: true) instead of the static array. `isActive` is a soft
// toggle (same "suspend, don't destroy" precedent as User.deletedAt) so a
// dish can be hidden without losing it; the admin UI also allows a real
// hard delete for a genuine mistake entry.
model FoodIdea {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  cuisine     String
  budgetTier  String   @map("budget_tier") // 'low' | 'medium' | 'high'
  tags        String[]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("food_ideas")
}

// Cache for the representative food photos shown on recommendation cards
// (the visual "what should I eat" experience). One row per normalised food
// name, so an image provider (Pexels, with Unsplash as fallback) is called
// at most once per distinct dish, ever — repeat recommendations reuse the
// row. Photos are hotlinked from the provider CDN as their API terms
// require; nothing is downloaded or re-hosted here. A lookup that found
// nothing is cached too (`status = "none"`) with a short TTL, so a miss
// doesn't re-hit the provider on every page load. See FoodImageService.
model FoodImageCache {
  id               String   @id @default(uuid())
  key              String   @unique // normalised food name (lowercased, punctuation-stripped)
  foodName         String   @map("food_name")
  searchQuery      String   @map("search_query")
  status           String   @default("ok") // "ok" | "none"
  provider         String? // "pexels" | "unsplash"
  imageUrl         String?  @map("image_url")
  thumbnailUrl     String?  @map("thumbnail_url")
  photographerName String?  @map("photographer_name")
  photographerUrl  String?  @map("photographer_url")
  sourceUrl        String?  @map("source_url")
  // Unsplash requires a GET to this endpoint when a photo is actually
  // displayed; null for Pexels (no such requirement).
  downloadLocation String?  @map("download_location")
  isRepresentative Boolean  @default(true) @map("is_representative")
  retrievedAt      DateTime @default(now()) @map("retrieved_at")

  @@map("food_image_cache")
}

// ---------------------------------------------------------------------------
// FoodPadi Memory & Companion — a deterministic behavioural-intelligence
// layer over FoodPadi's own decision events (docs: the Memory & Companion
// brief). Members only — a guest never gets a row in any of these three
// tables (guest-mode brief §16: no persistent behavioural profiling for
// guests). Deliberately food-decision facts only: no medical, location or
// unrelated-activity inference (see PatternService).

// One recomputed row per detected behaviour, upserted by (userId,
// patternType, patternKey) — e.g. ('meal_time', 'weekday_dinner'),
// ('day_routine', 'friday'), ('meal_repetition', 'Jollof Rice'). Recomputed
// lazily inside CompanionService.getSuggestion(), not on a schedule — see
// PatternService. `status` flips to "stale" once confidence decays below the
// floor; stale patterns are excluded from candidate generation but kept
// (not deleted) so a returning behaviour picks up its evidence history
// again instead of starting from zero.
model FoodPattern {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternType     String   @map("pattern_type")
  patternKey      String   @map("pattern_key")
  patternValue    String   @map("pattern_value")
  confidence      Float    @default(0)
  evidenceCount   Int      @default(0) @map("evidence_count")
  firstObservedAt DateTime @map("first_observed_at")
  lastObservedAt  DateTime @map("last_observed_at")
  status          String   @default("active") @map("status") // "active" | "stale"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, patternType, patternKey])
  @@index([userId, status])
  @@map("food_patterns")
}

// One row per suggestion actually generated and shown — the record
// suppression rules, negative-feedback learning and analytics all read from.
// `generatedAt`/`deliveredAt` are set together: returning a suggestion to the
// client from GET /companion/suggestion *is* delivering it.
model CompanionSuggestion {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestionType String    @map("suggestion_type") // "usual_time" | "use_what_you_have" | "goal_support" | "variety" | "routine" | "plan_support"
  reason         String
  score          Float
  metadata       Json?
  generatedAt    DateTime  @default(now()) @map("generated_at")
  deliveredAt    DateTime? @map("delivered_at")
  openedAt       DateTime? @map("opened_at")
  action         String? // "opened" | "accepted" | "dismissed" | "not_useful" | "do_not_remind"
  actionedAt     DateTime? @map("actioned_at")

  @@index([userId, generatedAt])
  @@index([userId, suggestionType])
  @@map("companion_suggestions")
}

// Per-user Companion controls (guest-mode brief §13 "user control"). One row,
// created lazily with defaults on first read — see CompanionService.
model CompanionPreference {
  userId               String   @id @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled              Boolean  @default(true)
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  // Suggestion types the user has explicitly asked never to see again
  // ("Don't remind me"), excluded from candidate generation until reset.
  mutedTypes           String[] @map("muted_types")
  maxDailySuggestions  Int      @default(1) @map("max_daily_suggestions")
  maxWeeklySuggestions Int      @default(3) @map("max_weekly_suggestions")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("companion_preferences")
}

// FoodPadi Daily Companion Reminders (docs brief: "Daily Companion
// Reminders") — a friendly "it's around your usual lunch/coffee time"
// nudge, entirely separate from Plan Ahead's per-meal reminders
// (MealPlan.defaultReminderOffsetMinutes) and Cooking Journey timers. One
// row per user, created lazily with every slot off (see
// DailyRemindersService) — mirrors CompanionPreference's shape exactly.
//
// `enabled` is the GLOBAL pause switch (brief §17): turning it off suspends
// every reminder below WITHOUT clearing the configured times, so turning it
// back on restores exactly what was there before. Each of the 8 slots below
// has its own independent enabled flag on top of that.
//
// Times are "HH:mm" 24h local strings, same convention as MealPlan.
// defaultMealTime/MealPlanItem.plannedTime — deliberately no stored
// timezone/UTC offset (brief §21/§22): the client always resolves and fires
// these against the device's own local clock, so DST and travel are handled
// for free by never converting through UTC in the first place.
model DailyReminderPreference {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true) @map("enabled")

  weekdayBreakfastEnabled Boolean @default(false) @map("weekday_breakfast_enabled")
  weekdayBreakfastTime    String? @map("weekday_breakfast_time")
  weekdayLunchEnabled     Boolean @default(false) @map("weekday_lunch_enabled")
  weekdayLunchTime        String? @map("weekday_lunch_time")
  weekdayDinnerEnabled    Boolean @default(false) @map("weekday_dinner_enabled")
  weekdayDinnerTime       String? @map("weekday_dinner_time")
  weekdayCoffeeEnabled    Boolean @default(false) @map("weekday_coffee_enabled")
  weekdayCoffeeTime       String? @map("weekday_coffee_time")

  weekendBreakfastEnabled Boolean @default(false) @map("weekend_breakfast_enabled")
  weekendBreakfastTime    String? @map("weekend_breakfast_time")
  weekendLunchEnabled     Boolean @default(false) @map("weekend_lunch_enabled")
  weekendLunchTime        String? @map("weekend_lunch_time")
  weekendDinnerEnabled    Boolean @default(false) @map("weekend_dinner_enabled")
  weekendDinnerTime       String? @map("weekend_dinner_time")
  weekendCoffeeEnabled    Boolean @default(false) @map("weekend_coffee_enabled")
  weekendCoffeeTime       String? @map("weekend_coffee_time")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daily_reminder_preferences")
}

// Explicit user feedback (Feedback & Rating brief) — a star rating plus
// optional quick tags/comment, given at most one occasion per row so
// cooking/eating the same recipe repeatedly and rating it each time
// accumulates real cumulative evidence rather than overwriting one row.
// Deliberately NOT unique-constrained per (user, entity) for that reason.
// Feeds PatternService's 'recipe_feedback'/'cuisine_feedback'/
// 'plan_satisfaction' detectors — explicit feedback is stronger evidence
// than the passive behavioural signals the other detectors use, weighted
// accordingly there rather than by a second confidence system here.
// Never read for allergy/medical inference — avoided_ingredients remains
// the only hard exclusion; feedback only ever adjusts soft ranking.
model FoodFeedback {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String    @map("entity_type") // "RECIPE" | "MEAL" | "PLAN"
  entityId   String    @map("entity_id") // Recipe.id | FoodIdea.id | MealPlan.id
  context    String // "EAT_NOW" | "COOK" | "PLAN" | "DECIDE" | "ORDER" | "OTHER"
  rating     Int // 1-5
  tags       String[] // quick-tag keys, e.g. ["loved_it", "would_make_again"]
  comment    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("food_feedback")
}

// ---------------------------------------------------------------------------
// FoodPadi Premium — the ONE authoritative subscription/entitlement record
// (docs/SUBSCRIPTION_MODEL.md "our backend's subscriptions table is the source
// of truth for entitlement, updated only via verified webhook events").
// Stripe Billing + hosted Checkout front the payment; this row is written only
// from a signature-verified Stripe webhook or the equivalent post-Checkout
// sync (BillingService.syncFromStripe*), never from a client-supplied flag.
//
// One row per user (userId is unique). Created lazily the first time the user
// starts Checkout — a free user has no row, which EntitlementService treats
// as "not premium".
//
// Price fields are deliberately split so a localized charge never overwrites
// the canonical commercial price:
//   basePriceCents / baseCurrency  — the $4.99 USD source-of-truth price
//   presentmentAmountCents / presentmentCurrency — what Stripe actually
//     charged this customer (copied verbatim from the paid invoice)
// No exchange rate is ever stored or computed here — the pre-checkout estimate
// is read live from the Stripe Price's currency_options, and the real charge
// is whatever Stripe's invoice says.
model Subscription {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which processor owns this subscription's billing. One row per user still —
  // a user is on exactly one provider at a time. "stripe" fronts card / Apple
  // Pay / Google Pay / Link / local methods with Adaptive Pricing; "flutterwave"
  // fronts the Nigeria journey (native NGN, cards, bank transfer, USSD).
  provider String @default("stripe") // "stripe" | "flutterwave"

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")

  // Flutterwave equivalents. `flwTxRef` is the client-generated reference we
  // send with the hosted-checkout call and match on the redirect / webhook;
  // `flwSubscriptionId` is Flutterwave's subscription id, used to cancel.
  flwPlanId         String? @map("flw_plan_id")
  flwSubscriptionId String? @unique @map("flw_subscription_id")
  flwTxRef          String? @unique @map("flw_tx_ref")
  flwCustomerEmail  String? @map("flw_customer_email")

  // For "stripe" this mirrors Stripe's subscription.status verbatim:
  //   "active" | "trialing" | "past_due" | "canceled" | "incomplete"
  //     | "incomplete_expired" | "unpaid" | "paused"
  // For "flutterwave" (which has no rich status model) it is one of:
  //   "active" | "canceled" | "incomplete"
  status String @default("incomplete")

  basePriceCents  Int    @default(499) @map("base_price_cents")
  baseCurrency    String @default("usd") @map("base_currency")
  billingInterval String @default("month") @map("billing_interval")

  presentmentAmountCents Int?    @map("presentment_amount_cents")
  presentmentCurrency    String? @map("presentment_currency")

  customerCountry   String?   @map("customer_country") // Stripe-confirmed billing country
  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt        DateTime? @map("canceled_at")
  trialEndsAt       DateTime? @map("trial_ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

// Admin-tunable subscription parameters — the "dynamic parameterised
// subscription value management" surface (apps/web/app/admin/billing). One row
// (`id = "singleton"`), created lazily with defaults by BillingConfigService.
// The billing engine reads these instead of hard-coded literals / env; the
// admin PUT also best-effort pushes changes to Stripe / Flutterwave (their
// Price / plan objects are immutable, so a base-price change mints a new one
// and its id is stored back here).
model BillingConfig {
  id                  String   @id @default("singleton")
  basePriceCents      Int      @default(499)
  baseCurrency        String   @default("usd")
  // Stripe-side, card-gated trial length (default 0 = charge immediately).
  trialDays           Int      @default(0)
  // In-app Guest/Trial/Paid model: no-card trial length, and the total number
  // of AI requests a trial user gets before AiAccessService blocks them.
  appTrialDays        Int      @default(7)
  trialAiLimit        Int      @default(20)
  // Payment-failure grace / dunning window: days a `past_due` subscription
  // keeps Premium after its paid period, so a failed renewal doesn't drop the
  // user instantly (the standard subscription-app behaviour). The
  // STRIPE_PAST_DUE_GRACE_DAYS env var, when set, overrides this.
  pastDueGraceDays    Int      @default(3)
  // Flutterwave (Nigeria) price, whole Naira per month.
  flwNgnAmount        Int      @default(7500)
  // Per-currency Stripe presentment amounts, minor units:
  //   { "gbp": 449, "eur": 499, "hkd": 3900, ... }
  currencyOptions     Json     @default("{}") @map("currency_options")
  // Set only when the base price / plan is changed from the admin UI (Stripe
  // Prices & Flutterwave plans can't be edited in place). Null → use the env value.
  stripePriceId       String?  @map("stripe_price_id")
  flwPlanId           String?  @map("flw_plan_id")
  // FoodPadi Food Dealer Network subscription — a SEPARATE product from Premium
  // (dealer brief §13) but its price is managed from the same admin billing
  // dashboard. Default $4.99 / month. `dealerStripePriceId` / `dealerFlwPlanId`
  // are set only when the price is changed from the admin UI (a fresh Stripe
  // Price / Flutterwave plan is minted); null → fall back to the env value.
  dealerPriceCents    Int      @default(499) @map("dealer_price_cents")
  dealerNgnAmount     Int      @default(7500) @map("dealer_ngn_amount")
  dealerStripePriceId String?  @map("dealer_stripe_price_id")
  dealerFlwPlanId     String?  @map("dealer_flw_plan_id")
  updatedBy           String?  @map("updated_by") // AdminStaffUser.id, best-effort
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("billing_config")
}

// Webhook idempotency ledger, shared by both providers — a processor may
// deliver the same event more than once, and events can arrive out of order.
// BillingService inserts the id here before running the handler; a duplicate
// delivery hits the primary-key conflict and is acked without reprocessing,
// and a handler failure deletes the row so the processor's retry can run.
// `id` is namespaced per provider: "stripe:evt_1P..." / "flutterwave:<txn id>".
model WebhookEvent {
  id          String   @id
  provider    String   @default("stripe") // "stripe" | "flutterwave"
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([type])
  @@map("webhook_events")
}

// Daily foreign-exchange snapshot behind the paywall's "estimated local
// equivalent" line. Refreshed at most once per ~20h — lazily on the first
// read after it goes stale, plus an admin "Refresh now" button (Render's free
// tier spins down, so a cron can't be relied on). Display-only: the estimate
// is always labelled as such and the payment provider's checkout amount stays
// authoritative for the actual charge (docs/SUBSCRIPTION_MODEL.md §20). One
// row, id = "latest".
model FxRateSnapshot {
  id           String   @id @default("latest")
  baseCurrency String   @default("usd") @map("base_currency")
  // { "gbp": 0.787, "eur": 0.921, "ngn": 1650.5, ... } — units of that
  // currency per 1 unit of baseCurrency.
  rates        Json     @default("{}")
  source       String?
  fetchedAt    DateTime @default(now()) @map("fetched_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("fx_rate_snapshots")
}

// The persistent, resumable "cook this meal" flow (docs cooking-journey
// brief). One ACTIVE journey per user (partial unique index in the
// migration); it survives navigation, app close and logout because the row —
// not React/session state — is the source of truth. The client state
// machines (CookTodayForm / CookingSession) still drive the UI; this mirrors
// their position so "Resume" lands the user exactly where they left off.
//
// No Prisma enums anywhere in this schema — `stage` / `status` / `timerStatus`
// are strings with the allowed values listed inline, same as MealPlan.status
// etc. Recipe is referenced (not duplicated); `recipeSnapshot` is a frozen
// RecipeView kept only so the journey still renders if the Recipe row is
// later deleted (onDelete: SetNull).
model CookingJourney {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeId       String? @map("recipe_id")
  recipe         Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeSnapshot Json    @map("recipe_snapshot")

  // "recipe_selected" | "ingredient_check" | "shopping" | "ready_to_cook" | "cooking" | "feedback_pending"
  stage       String @default("recipe_selected")
  // "active" | "completed" | "cancelled" | "abandoned"
  status      String @default("active")
  // 0-based cooking-step cursor; only meaningful once stage reaches "cooking".
  currentStep Int    @default(0) @map("current_step")

  // FridgeCheck's have/need split: { "have": string[], "need": string[] }.
  // Per-item purchase progress lives on ShoppingListItem.checked, not here.
  ingredientStatus Json? @map("ingredient_status")

  // The fridge-check "need to buy" list. @unique so re-running the check
  // replaces cleanly and the back-relation on ShoppingList is a to-one.
  shoppingListId String?       @unique @map("shopping_list_id")
  shoppingList   ShoppingList? @relation(fields: [shoppingListId], references: [id], onDelete: SetNull)

  // Set when the journey started from a Plan Ahead meal — lets a plan
  // reminder deep-link straight into the active journey (brief §22).
  mealPlanItemId String?       @map("meal_plan_item_id")
  mealPlanItem   MealPlanItem? @relation(fields: [mealPlanItemId], references: [id], onDelete: SetNull)

  // Step timer. Remaining is always COMPUTED from these (see
  // packages/shared/src/cookingJourney.ts computeTimerRemaining), never a
  // stored counter. running: `timerEndsAt` is the wall-clock target.
  // paused: `timerRemainingSeconds` is the frozen value. done/idle: null.
  timerStatus           String?   @map("timer_status") // "running" | "paused" | "done" | null
  timerDurationSeconds  Int?      @map("timer_duration_seconds")
  timerEndsAt           DateTime? @map("timer_ends_at")
  timerRemainingSeconds Int?      @map("timer_remaining_seconds")

  // The FoodFeedback row once the cook rates the meal (loose reference, same
  // as FoodFeedback.entityId — no FK).
  feedbackId         String?   @map("feedback_id")
  cookingStartedAt   DateTime? @map("cooking_started_at")
  cookingCompletedAt DateTime? @map("cooking_completed_at")
  lastActivityAt     DateTime  @default(now()) @map("last_activity_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("cooking_journeys")
}

// ---------------------------------------------------------------------------
// FoodPadi Food Dealer Network (dealer brief) — a web-only B2B onboarding +
// subscription + management product. Dealer data lives here in the shared
// backend and is consumed by BOTH web and mobile customer discovery (brief
// §21). All customer-facing reads go through DealerSearchService, which only
// ever exposes a curated public view — payment state, owner identity and
// unpublished prices never leave the portal (brief §42/§51/§64).
//
// No Prisma enums (house style — see MealPlan.status etc.): string columns with
// the allowed values listed inline.

model Dealer {
  id          String @id @default(uuid())
  // Stable public identifier for /dealer/<slug> + the search API. Derived from
  // the name (kebab-case), disambiguated with the primary locality on collision.
  slug        String @unique
  // Ownership key — a normal customer User. Every portal endpoint authorizes on
  // `dealer.ownerUserId === req.user.userId`; a client-supplied dealerId is
  // never trusted (brief §52).
  ownerUserId String @map("owner_user_id")
  owner       User   @relation("DealerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  name        String
  description String?
  // One of packages/shared DEALER_TYPES (brief §4).
  dealerType  String  @map("dealer_type")

  // Contact / ordering channels — only ever stored when the dealer supplies
  // them, shown as-is, never fabricated (brief §27).
  phone        String?
  websiteUrl   String? @map("website_url")
  orderUrl     String? @map("order_url")
  whatsapp     String?
  // Free-form { "mon": "09:00-18:00", ... }. Shown as-is; never parsed into an
  // "open now" claim on the client (same posture as local-food-search's raw
  // opening_hours passthrough).
  openingHours Json?   @map("opening_hours")

  // Searchable taxonomy (brief §3/§6/§7). Free-text arrays — no master catalog,
  // same principle as Recipe ingredients. DealerSearchProfile denormalises
  // these (+ products + locations) into the actual search index.
  categories      String[]
  cuisines        String[]
  productKeywords String[] @map("product_keywords")
  dietaryTags     String[] @map("dietary_tags")
  serviceType     String[] @map("service_type")

  // Moderation + approval lifecycle. EFFECTIVE customer visibility is
  // (listingStatus == 'active' && dealer subscription active) — see
  // DealerEntitlementService. 'active' is reachable ONLY from 'approved' (or
  // 'expired' on renewal) — DealerSearchProfileService.rebuild is the sole
  // writer, so a payment can never promote a dealer past admin review
  // (admin-approval-before-payment business rule, 2026-09-11). "expired" is
  // set lazily by the search/portal read once the subscription lapses past the
  // grace window (brief §25), mirroring EntitlementService's lazy trial-expiry
  // (no cron).
  //   'draft' | 'pending_review' | 'changes_requested' | 'approved' | 'active'
  //   | 'rejected' | 'suspended' | 'expired'
  listingStatus      String    @default("draft") @map("listing_status")
  // Admin's message on a 'changes_requested'/'rejected' decision — shown to the
  // dealer verbatim, cleared on resubmission.
  approvalNote       String?   @map("approval_note")
  approvalReviewedAt DateTime? @map("approval_reviewed_at")
  // A paid subscription does NOT imply verification (brief §23). Only a
  // completed FoodPadi verification process sets 'verified'.
  //   'unverified' | 'verified'
  verificationStatus String    @default("unverified") @map("verification_status")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by") // AdminStaffUser.id, best-effort

  // 0-100, recomputed by DealerPortalService.scoreCompleteness on every write.
  // Feeds ranking (quality signal) and Featured eligibility (brief §10/§17).
  profileCompleteness Int @default(0) @map("profile_completeness")

  // Denormalised from DealerRating so search/list reads never join+aggregate
  // per candidate. Recomputed by DealerRatingService on every rating write.
  // null average = no ratings yet (never shown as "0 stars").
  ratingAverage Float? @map("rating_average")
  ratingCount   Int    @default(0) @map("rating_count")

  submittedAt DateTime? @map("submitted_at")
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  locations     DealerLocation[]
  products      DealerProduct[]
  subscription  DealerSubscription?
  searchProfile DealerSearchProfile?
  events        DealerEvent[]
  reports       DealerReport[]
  ratings       DealerRating[]
  auditLogs     DealerAuditLog[]

  @@index([ownerUserId])
  @@index([listingStatus])
  @@map("dealers")
}

// Approval/lifecycle audit trail (admin-approval-before-payment business rule,
// 2026-09-11, brief §17) — every submit / resubmit / admin decision / payment
// activation is recorded here, oldest first, surfaced to admin on the dealer
// detail page. `adminId` is best-effort (AdminApiGuard doesn't carry a
// per-staff id through yet, same posture as Dealer.verifiedBy) and null for
// dealer-initiated or system (payment webhook) entries.
model DealerAuditLog {
  id             String   @id @default(uuid())
  dealerId       String   @map("dealer_id")
  dealer         Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  adminId        String?  @map("admin_id")
  action         String
  previousStatus String?  @map("previous_status")
  newStatus      String?  @map("new_status")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([dealerId, createdAt])
  @@map("dealer_audit_logs")
}

// A dealer may have one or more branches / a distributor service area (brief
// §31/§32). The data model is multi-location from day one even though the MVP
// dashboard UI focuses on one primary site + service areas.
model DealerLocation {
  id       String @id @default(uuid())
  dealerId String @map("dealer_id")
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  label              String?
  addressLine        String?  @map("address_line")
  // Town/city name used for locality search ("Leicester"). Required — a location
  // with no locality can't be matched or shown.
  locality           String
  city               String?
  region             String? // county / state
  postcode           String?
  countryCode        String   @default("GB") @map("country_code")
  latitude           Float?
  longitude          Float?
  isPrimary          Boolean  @default(false) @map("is_primary")
  // Localities served beyond the physical site (a distributor covering
  // "Leicester", "Loughborough", "Market Harborough"). Never arbitrary — the
  // portal validates these are real place names (brief §31).
  serviceAreas       String[] @map("service_areas")
  serviceRadiusMiles Int?     @map("service_radius_miles")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@index([locality])
  @@map("dealer_locations")
}

model DealerProduct {
  id       String @id @default(uuid())
  dealerId String @map("dealer_id")
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  name          String
  category      String?
  description   String?
  // A pasted external https:// link. Mutually exclusive with imageData below —
  // setting one clears the other (a product has at most one image, either
  // hosted elsewhere or uploaded to us).
  imageUrl      String?  @map("image_url")
  // An uploaded photo, resized + re-encoded server-side (product-image.util.ts)
  // and stored as real binary — there's no object storage provider configured
  // for this app, so Postgres bytea is the pragmatic home for it (images are
  // capped small enough that this stays cheap). Served via
  // GET /dealers/products/:id/image, never embedded in JSON list/search
  // responses.
  imageData     Bytes?   @map("image_data")
  imageMimeType String?  @map("image_mime_type")
  available     Boolean  @default(true)
  // Optional — dealers may list products without publishing a price (brief §18).
  pricePence    Int?     @map("price_pence")
  unit          String?
  // Normalised synonyms seeded from the name, used by the search engine so
  // "jollof" matches "Jollof Rice" (brief §36). Recomputed on write.
  keywords      String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dealerId])
  @@map("dealer_products")
}

// The dealer's B2B subscription. A SEPARATE product from FoodPadi Premium —
// deliberately its own table, never sharing a row with `subscriptions` (brief
// §13). Shape mirrors Subscription so the provider plumbing (StripeService /
// FlutterwaveService) is reused as-is. One row per dealer.
model DealerSubscription {
  id       String @id @default(uuid())
  dealerId String @unique @map("dealer_id")
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  provider String @default("stripe") // "stripe" | "flutterwave"

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")

  flwPlanId         String? @map("flw_plan_id")
  flwSubscriptionId String? @unique @map("flw_subscription_id")
  flwTxRef          String? @unique @map("flw_tx_ref")
  flwCustomerEmail  String? @map("flw_customer_email")

  // Stripe: mirrors subscription.status verbatim. Flutterwave: "active" |
  // "canceled" | "incomplete".
  status String @default("incomplete")

  plan            String @default("dealer_monthly")
  basePriceCents  Int    @default(2900) @map("base_price_cents")
  baseCurrency    String @default("usd") @map("base_currency")
  billingInterval String @default("month") @map("billing_interval")

  presentmentAmountCents Int?    @map("presentment_amount_cents")
  presentmentCurrency    String? @map("presentment_currency")

  customerCountry   String?   @map("customer_country")
  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt        DateTime? @map("canceled_at")
  trialEndsAt       DateTime? @map("trial_ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dealer_subscriptions")
}

// Denormalised search index for one dealer — rebuilt by
// DealerSearchProfileService.rebuild() after every portal write AND every
// subscription state change. DealerSearchService queries THIS table only, never
// the normalised dealer/product/location rows, so a customer search is one
// indexed read (brief §35: reuse Postgres, no Elasticsearch).
model DealerSearchProfile {
  dealerId String @id @map("dealer_id")
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  // Space-joined blob of name + categories + cuisines + product names +
  // localities, lowercased. Matched with ILIKE / to_tsvector (brief §35).
  searchText     String   @map("search_text")
  // Normalised lowercase arrays for exact-term scoring in dealer-ranking.ts.
  localities     String[]
  categoriesNorm String[] @map("categories_norm")
  productsNorm   String[] @map("products_norm")
  cuisinesNorm   String[] @map("cuisines_norm")

  primaryLat Float? @map("primary_lat")
  primaryLng Float? @map("primary_lng")

  completeness       Int     @default(0)
  // Mirror of Dealer.ratingAverage/ratingCount — a quality signal in ranking
  // (dealer-ranking.ts), only once ratingCount clears DEALER_RATING_MIN_FOR_RANKING.
  ratingAverage      Float?  @map("rating_average")
  ratingCount        Int     @default(0) @map("rating_count")
  // completeness >= threshold AND listingStatus 'active' AND subscription
  // active. The search engine still re-checks the relevance + locality floors
  // per query before actually placing a dealer in a Featured slot (brief §37).
  featuredEligible   Boolean @default(false) @map("featured_eligible")
  // Mirror of Dealer.listingStatus + a resolved "subscription active" flag so
  // the search query needs no join.
  listingStatus      String  @default("draft") @map("listing_status")
  subscriptionActive Boolean @default(false) @map("subscription_active")

  lastBuiltAt DateTime @default(now()) @map("last_built_at")

  @@index([listingStatus, subscriptionActive])
  @@map("dealer_search_profiles")
}

// Aggregate discovery analytics (brief §43/§55). NEVER stores customer PII —
// `query` is the raw search string, unattached to any user or session; location
// is coarse locality only (brief §42).
model DealerEvent {
  id       String @id @default(uuid())
  dealerId String @map("dealer_id")
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  // 'search_appearance' | 'featured_impression' | 'profile_view' |
  // 'website_click' | 'phone_click' | 'direction_click' | 'order_click'
  type     String
  locality String?
  query    String?

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([dealerId, type, occurredAt])
  @@map("dealer_events")
}

// Customer-submitted report of a wrong/closed/incorrect/inappropriate listing
// (brief §40). Deliberately minimal — no reviews, stars or social (brief §41).
model DealerReport {
  id             String  @id @default(uuid())
  dealerId       String  @map("dealer_id")
  dealer         Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  // Nullable: a guest can report too (same posture as local-food-search).
  reporterUserId String? @map("reporter_user_id")
  reporter       User?   @relation("DealerReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  reason String // 'wrong_business' | 'closed' | 'incorrect_info' | 'inappropriate'
  detail String?
  status String  @default("open") // 'open' | 'reviewed' | 'actioned' | 'dismissed'

  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String?   @map("reviewed_by") // AdminStaffUser.id

  @@index([dealerId])
  @@index([status])
  @@map("dealer_reports")
}

// Post-visit customer rating of a dealer (user instruction 2026-09-11). Kept
// deliberately narrow, NOT a review/social feed (dealer brief §41/§78 — no
// likes, no followers, no comment threads): one star rating + an optional
// short comment per customer per dealer, tied to that business only, editable
// by the rater, moderatable by admin. Account-only (no guest ratings) — same
// posture as Feedback (guests have no persistent Memory to attach this to).
model DealerRating {
  id       String @id @default(uuid())
  dealerId String @map("dealer_id")
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation("DealerRater", fields: [userId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  comment String?

  // Admin moderation (brief §39/§40 — trust & safety), independent of the
  // rating value itself; a hidden rating is excluded from the public list and
  // the dealer's aggregate.
  hidden   Boolean   @default(false)
  hiddenBy String?   @map("hidden_by") // AdminStaffUser.id, best-effort
  hiddenAt DateTime? @map("hidden_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One rating per customer per dealer — re-rating updates it in place rather
  // than piling up duplicates (this is a rating, not a comment thread).
  @@unique([dealerId, userId])
  @@index([dealerId, hidden])
  @@map("dealer_ratings")
}
