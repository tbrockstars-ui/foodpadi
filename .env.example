# API (apps/api)
# Neon Postgres — use the pooled connection string for the app runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/foodpadi?sslmode=require
# Neon's direct (unpooled) connection string — Prisma Migrate needs this, not the pooled one.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/foodpadi?sslmode=require
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_GUEST_SECRET=change-me-guest
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_GUEST_TTL=24h
PORT=4310

# Third-party (never commit real values)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
REVENUECAT_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=

# Representative food photos on recommendation cards (apps/api/src/modules/food-image).
# Server-side only — never exposed to the web/mobile clients. With neither key
# set, recommendation cards fall back to a branded placeholder (no broken
# images, nothing misleading), so this is optional for local dev.
# Pexels is the preferred provider: free API key from https://www.pexels.com/api/
PEXELS_API_KEY=
# Unsplash is the fallback, tried only when Pexels finds nothing suitable.
# Free "Access Key" from https://unsplash.com/developers (leave blank to disable).
UNSPLASH_ACCESS_KEY=

# Not currently used by any feature. An earlier pass built local food
# discovery ("find this food near me" in Eat Now) on Gemini's google_maps
# grounding tool, but that tool has no free tier — it requires a
# billing-enabled Google Cloud project and per-search cost — so the feature
# was rebuilt on the free OpenStreetMap Nominatim/Overpass APIs instead (no
# key needed at all, see apps/api/src/modules/local-food-search). Left here
# in case a future pass revisits paid Gemini grounding for richer results.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Scan demo mode — when "true", photo/scan analysis is served by a
# deterministic local mock (never sent to Anthropic) instead of real vision,
# so Scan's UX can be validated with no ANTHROPIC_API_KEY and no AI spend.
# Set to "false" (or unset) once a real key is configured and you want real
# vision analysis. Does not affect Cook Today/Plan Ahead's own fallback.
SCAN_DEMO_MODE=true

# Web (apps/web) — placeholder admin gate only, see apps/web/README.md.
# Replace with real per-person staff auth before any real admin data is wired up.
ADMIN_ACCESS_CODE=change-me
ADMIN_SESSION_SECRET=change-me-too
# Shared secret between apps/web's admin-proxy route and the API's AdminApiGuard
# (apps/api/src/modules/admin) — server-to-server only, never sent to a browser.
# Must match on both apps/api and apps/web.
ADMIN_API_SECRET=change-me-admin-api

# Customer web app origin — used by the API for credentialed CORS.
WEB_APP_URL=http://localhost:3100
