# API (apps/api)
# Neon Postgres — use the pooled connection string for the app runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/foodpadi?sslmode=require
# Neon's direct (unpooled) connection string — Prisma Migrate needs this, not the pooled one.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/foodpadi?sslmode=require
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_GUEST_SECRET=change-me-guest
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_GUEST_TTL=24h
PORT=4310

# Third-party (never commit real values)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
REVENUECAT_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=

# FoodPadi Premium — Stripe Billing + hosted Checkout (apps/api/src/modules/billing).
# With STRIPE_SECRET_KEY / STRIPE_PRICE_ID unset the API still boots and every
# non-billing feature works; the /billing/* endpoints just return 503.
# 1. Put STRIPE_SECRET_KEY here, then run `npm run stripe:setup --workspace=@foodpadi/api`
#    to create the canonical $4.99 USD/month product + price and print the ids.
# 2. Add a webhook endpoint (https://<api-host>/billing/webhook) in the Stripe
#    Dashboard and copy its signing secret to STRIPE_WEBHOOK_SECRET.
# 3. Enable Adaptive Pricing and configure the Billing customer portal in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Required for the admin dashboard's "change base price" action (Stripe Prices
# are immutable, so a change mints a new Price on this Product).
STRIPE_PRODUCT_ID=
# NOTE: price, trial length, per-currency amounts and the NG price are now
# managed live in the admin dashboard (Admin → Subscription / the billing_config
# table). The values below are only the seed used before an admin edits them.
# Optional. Unset = charge immediately (no trial). Set (e.g. 3) to offer a trial.
STRIPE_TRIAL_DAYS=
# Optional. "true" turns on Stripe Tax on Checkout (requires Stripe Tax set up).
STRIPE_AUTOMATIC_TAX=
# Optional OVERRIDE for the payment-failure grace / dunning window (days a
# past_due subscription keeps Premium after its paid period). Normally managed
# in the admin dashboard (billing_config.pastDueGraceDays, default 3); set this
# only to force a value from the environment.
STRIPE_PAST_DUE_GRACE_DAYS=
# Optional. Pin a specific Billing portal configuration id.
STRIPE_PORTAL_CONFIGURATION_ID=
# Demo mode (same idea as FLW_DEMO_MODE / SCAN_DEMO_MODE): "true" makes the
# whole Premium subscribe/manage/cancel journey work with NO Stripe account and
# NO real card — checkout points at FoodPadi's own /premium/stripe-demo-checkout
# page, "manage" at /premium/stripe-demo-portal, and the "payment" unlocks
# Premium the same way a real one does. For MVP demos / UX validation only. Set
# to "false" (or unset) once a real STRIPE_SECRET_KEY / STRIPE_PRICE_ID are in
# place — `npm run stripe:setup` still needs those either way.
STRIPE_DEMO_MODE=true

# FoodPadi Premium — Flutterwave (Nigeria). Stripe cannot present NGN, so NG
# customers are routed to Flutterwave (native NGN, card / bank transfer / USSD).
# With FLW_SECRET_KEY / FLW_PLAN_ID unset, Nigeria simply falls back to Stripe
# card-in-USD. Setup:
# 1. Put FLW_SECRET_KEY + FLW_NGN_AMOUNT (whole Naira, e.g. 7500), then run
#    `npm run flw:setup --workspace=@foodpadi/api` to create the monthly plan
#    and print FLW_PLAN_ID.
# 2. In the Flutterwave dashboard set a webhook URL (https://<api-host>/billing/
#    flutterwave/webhook) and a "Secret hash"; put that hash in FLW_SECRET_HASH.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_PLAN_ID=
# Whole Naira per month — used by `flw:setup` to create the plan and by demo
# mode. Once a real plan exists, its amount (held by Flutterwave) is the source
# of truth.
FLW_NGN_AMOUNT=7500
# Demo mode (same idea as SCAN_DEMO_MODE): "true" makes the whole Nigeria
# journey work with NO Flutterwave account and NO real money — checkout points
# at FoodPadi's own /premium/demo-checkout page and the "payment" is treated as
# a successful NGN charge. For MVP demos / UX validation only. Set to "false"
# (or unset) once real FLW_SECRET_KEY / FLW_PLAN_ID are in place.
FLW_DEMO_MODE=true

# FoodPadi Food Dealer Network — the B2B dealer subscription (apps/api/src/
# modules/dealers). A SEPARATE product from Premium: its own Stripe Price and
# webhook secret, its own Flutterwave plan, never sharing the `subscriptions`
# row. In demo mode (STRIPE_DEMO_MODE / FLW_DEMO_MODE above) the whole dealer
# subscribe/activate/cancel journey works with no provider account.
# Setup for real keys:
# 1. With STRIPE_SECRET_KEY set, run `npm run stripe:dealer-setup --workspace=@foodpadi/api`
#    to create the monthly dealer Price and print STRIPE_DEALER_PRICE_ID.
# 2. Add a Stripe webhook endpoint for https://<api-host>/dealers/billing/webhook
#    and copy its signing secret to STRIPE_DEALER_WEBHOOK_SECRET.
# 3. (Nigeria) create a Flutterwave payment plan for the dealer NGN amount and
#    put its id in FLW_DEALER_PLAN_ID; the webhook URL is
#    https://<api-host>/dealers/billing/flutterwave/webhook (reuses FLW_SECRET_HASH).
STRIPE_DEALER_PRICE_ID=
STRIPE_DEALER_WEBHOOK_SECRET=
FLW_DEALER_PLAN_ID=
# The dealer subscription price is managed LIVE in the admin dashboard
# (Admin → Subscription → "Food Dealer price" / billing_config.dealerPriceCents,
# default 499 = $4.99 / month). The two vars below are only a last-resort
# fallback if that row is missing.
DEALER_SUB_PRICE_CENTS=499
# Nigeria (Flutterwave) dealer price fallback, whole Naira per month.
DEALER_SUB_NGN_AMOUNT=7500
# Optional. Payment-failure grace window (days) for a past_due dealer
# subscription. Falls back to STRIPE_PAST_DUE_GRACE_DAYS, then the admin
# billing_config value.
DEALER_PAST_DUE_GRACE_DAYS=

# Representative food photos on recommendation cards (apps/api/src/modules/food-image).
# Server-side only — never exposed to the web/mobile clients. With neither key
# set, recommendation cards fall back to a branded placeholder (no broken
# images, nothing misleading), so this is optional for local dev.
# Pexels is the preferred provider: free API key from https://www.pexels.com/api/
PEXELS_API_KEY=
# Unsplash is the fallback, tried only when Pexels finds nothing suitable.
# Free "Access Key" from https://unsplash.com/developers (leave blank to disable).
UNSPLASH_ACCESS_KEY=

# "Continue with Google" sign-in. Comma-separated list of accepted Google
# OAuth client IDs — Google issues a separate one per platform (Web, Android,
# iOS), and the API accepts an ID token minted for any of them. Include at
# least the Web client id (same value as apps/web's NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Blank => the /auth/google endpoint returns 503 and the web button is hidden.
GOOGLE_OAUTH_CLIENT_IDS=

# Not currently used by any feature. An earlier pass built local food
# discovery ("find this food near me" in Eat Now) on Gemini's google_maps
# grounding tool, but that tool has no free tier — it requires a
# billing-enabled Google Cloud project and per-search cost — so the feature
# was rebuilt on the free OpenStreetMap Nominatim/Overpass APIs instead (no
# key needed at all, see apps/api/src/modules/local-food-search). Left here
# in case a future pass revisits paid Gemini grounding for richer results.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Scan demo mode — when "true", photo/scan analysis is served by a
# deterministic local mock (never sent to Anthropic) instead of real vision,
# so Scan's UX can be validated with no ANTHROPIC_API_KEY and no AI spend.
# Set to "false" (or unset) once a real key is configured and you want real
# vision analysis. Does not affect Cook Today/Plan Ahead's own fallback.
SCAN_DEMO_MODE=true

# Web (apps/web) — placeholder admin gate only, see apps/web/README.md.
# Replace with real per-person staff auth before any real admin data is wired up.
ADMIN_ACCESS_CODE=change-me
ADMIN_SESSION_SECRET=change-me-too
# Shared secret between apps/web's admin-proxy route and the API's AdminApiGuard
# (apps/api/src/modules/admin) — server-to-server only, never sent to a browser.
# Must match on both apps/api and apps/web.
ADMIN_API_SECRET=change-me-admin-api

# Customer web app origin — used by the API for credentialed CORS.
WEB_APP_URL=http://localhost:3100
