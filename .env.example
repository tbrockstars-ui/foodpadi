# API (apps/api)
# Neon Postgres — use the pooled connection string for the app runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/foodpadi?sslmode=require
# Neon's direct (unpooled) connection string — Prisma Migrate needs this, not the pooled one.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/foodpadi?sslmode=require
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_GUEST_SECRET=change-me-guest
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_GUEST_TTL=24h
PORT=4310

# Third-party (never commit real values)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
REVENUECAT_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=

# Scan demo mode — when "true", photo/scan analysis is served by a
# deterministic local mock (never sent to Anthropic) instead of real vision,
# so Scan's UX can be validated with no ANTHROPIC_API_KEY and no AI spend.
# Set to "false" (or unset) once a real key is configured and you want real
# vision analysis. Does not affect Cook Today/Plan Ahead's own fallback.
SCAN_DEMO_MODE=true

# Web (apps/web) — placeholder admin gate only, see apps/web/README.md.
# Replace with real per-person staff auth before any real admin data is wired up.
ADMIN_ACCESS_CODE=change-me
ADMIN_SESSION_SECRET=change-me-too

# Customer web app origin — used by the API for credentialed CORS.
WEB_APP_URL=http://localhost:3100
