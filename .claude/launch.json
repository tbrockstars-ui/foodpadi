{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mobile:start"],
      "port": 8081
    },
    {
      "name": "mobile-clean",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=@foodpadi/mobile", "--", "--clear"],
      "port": 8081
    },
    {
      "name": "mobile-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=@foodpadi/mobile", "--", "--offline", "--clear"],
      "port": 8081
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=@foodpadi/mobile", "--", "--web"],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "api:dev"],
      "port": 4310
    },
    {
      "name": "api-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--workspace=@foodpadi/api"],
      "port": 4310,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web:dev"],
      "port": 3100
    },
    {
      "name": "web-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@foodpadi/web"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "web-3200",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@foodpadi/web", "--", "-p", "3200"],
      "port": 3200
    },
    {
      "name": "web-3000",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@foodpadi/web", "--", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=@foodpadi/web", "--", "-p", "3000"],
      "port": 3000
    }
  ]
}
